p works","x":0,"y":13,"style":"lift","rules":[{"line":"","when":[{"signal":"admitted","value":1}],"award":"","move":"","to":"LanternCourt"},{"line":"The lift needs a name on the night roll.","when":[],"award":"","move":"","to":""}],"note":0},{"id":"A_Heart","label":"The resonator","x":8,"y":9,"style":"lift","rules":[{"line":"","when":[{"signal":"reed","value":1},{"signal":"yoke","value":1},{"signal":"glass","value":1}],"award":"","move":"","to":"EchoRotunda"},{"line":"Three sockets on the lintel: a river reed, a bronze yoke, and a disc of nightglass.","when":[],"award":"","move":"","to":""}],"note":0},{"id":"A_Plan","label":"Cistern survey","x":-8,"y":8,"style":"leaf","rules":[{"line":"West measures the water. East balances bronze. North keeps the night lamps. Their buried service stairs join behind the works.","when":[],"award":"","move":"","to":""}],"note":0},{"id":"A_Nema","label":"Nema the archivist","x":-5,"y":-8.1,"style":"person","rules":[{"line":"NEMA  /  Four places at supper tonight. I have already laid out the plates.","when":[{"signal":"named","value":1}],"award":"","move":"","to":""},{"line":"NEMA  /  Ina, fourth hand of the night shift. There. A name, a wage, a place at the table. I can put the book away now.","when":[{"signal":"token","value":1}],"award":"named","move":"","to":""},{"line":"NEMA  /  Fen can tie the pilots\u2019 knot. Orrel kept the pay leaf. Brannic knows what the fourth hand earned. Take those three proofs to Ossa at the casting bed.","when":[{"signal":"petition","value":1}],"award":"","move":"","to":""},{"line":"NEMA  /  The roll lists three trades. Our soup pot fed four. If you learn who the fourth hand was, bring me something I can file.","when":[],"award":"petition","move":"","to":""}],"note":2}],"visuals":[{"node":"Beacon0","signal":"reed","kind":"show","amount":1,"match":1},{"node":"Beacon1","signal":"yoke","kind":"show","amount":1,"match":1},{"node":"Beacon2","signal":"glass","kind":"show","amount":1,"match":1}]},{"key":"TwinIntake","title":"The Divided Intake","intro":"A rain tank holds three measures. A spring tank holds five. The blue chalk mark in the deep tank stands at four.","theme":"Waterworks","stations":[{"id":"A_Rain","label":"Fill the rain tank","x":-9,"y":-4,"style":"valve","rules":[{"line":"West gauge {small}/3. East gauge {deep}/5.","when":[],"award":"","move":"water.rain","to":""}],"note":0},{"id":"A_Spring","label":"Fill the spring tank","x":9,"y":-4,"style":"valve","rules":[{"line":"West gauge {small}/3. East gauge {deep}/5.","when":[],"award":"","move":"water.spring","to":""}],"note":0},{"id":"A_DrainA","label":"Drain the rain tank","x":-9,"y":4,"style":"valve","rules":[{"line":"West gauge {small}/3. East gauge {deep}/5.","when":[],"award":"","move":"water.wasteA","to":""}],"note":0},{"id":"A_DrainB","label":"Drain the spring tank","x":9,"y":4,"style":"valve","rules":[{"line":"West gauge {small}/3. East gauge {deep}/5.","when":[],"award":"","move":"water.wasteB","to":""}],"note":0},{"id":"A_East","label":"Pour west to east","x":-2,"y":-4,"style":"valve","rules":[{"line":"West gauge {small}/3. East gauge {deep}/5.","when":[],"award":"","move":"water.east","to":""}],"note":0},{"id":"A_West","label":"Pour east to west","x":2,"y":-4,"style":"valve","rules":[{"line":"West gauge {small}/3. East gauge {deep}/5.","when":[],"award":"","move":"water.west","to":""}],"note":0},{"id":"A_Float","label":"Test the lock float","x":0,"y":6,"style":"lever","rules":[{"line":"The float touches the fourth notch. Counterweights lift the archive gate.","when":[{"signal":"deep","value":4}],"award":"wetKey","move":"","to":""},{"line":"The float reads {deep}. The blue notch is four.","when":[],"award":"","move":"","to":""}],"note":0},{"id":"A_Plate","label":"Pipe diagram","x":-13,"y":9,"style":"leaf","rules":[{"line":"The brass crossfeeds stop when the receiving tank fills or the source runs dry. Spill water at either drain. Only the east gauge sets the lock.","when":[],"award":"","move":"","to":
e":"relic","rules":[{"line":"INA  /  I did promise to keep watch. I never promised to stop growing up. Tell Tavi I still want the window by the river.","when":[{"signal":"phrase","value":5}],"award":"answered","move":"","to":""},{"line":"The instrument is waiting for the complete phrase.","when":[],"award":"","move":"","to":""}],"note":0},{"id":"A_Home","label":"Cistern lift","x":-12,"y":-10,"style":"lift","rules":[{"line":"","when":[],"award":"","move":"","to":"SumpHall"}],"note":0},{"id":"A_Final","label":"Lift to the Still Belfry","x":12,"y":-10,"style":"lift","rules":[{"line":"","when":[{"signal":"answered","value":1}],"award":"","move":"","to":"Wrenfall"},{"line":"Speak to the voice beneath the floor after playing the phrase.","when":[],"award":"","move":"","to":""}],"note":0}],"visuals":[{"node":"Mouth0","signal":"reedSet","kind":"show","amount":1,"match":1},{"node":"Mouth1","signal":"yokeSet","kind":"show","amount":1,"match":1},{"node":"Mouth2","signal":"glassSet","kind":"show","amount":1,"match":1},{"node":"BellHeart","signal":"phrase","kind":"show","amount":1,"match":5}]},{"key":"Wrenfall","title":"Wrenfall Head","intro":"Find Mirren at the chart shelter. A pilot cutter is waiting outside the reef.","theme":"Wrenfall","stations":[{"id":"A_Pilot","label":"Mirren, shore pilot","x":-4,"y":-9,"style":"person","rules":[{"line":"MIRREN  /  Tell the bell keeper who brought us in. All seven hands signed this page. Everyone who did the work gets a line.","when":[{"signal":"landed","value":1}],"award":"","move":"","to":""},{"line":"MIRREN  /  Draw a triangle on my chart. West is the tide chapel. East is the split stone. The watcher on the north bluff can read the cutter\u2019s last lamp.","when":[{"signal":"charter","value":1}],"award":"","move":"","to":""},{"line":"MIRREN  /  The Linnet is carrying the last flood book. Her skipper can see our headland, but the guide lamps went out. Take my chart. I will meet her at the landing.","when":[],"award":"charter","move":"","to":""}],"note":2},{"id":"A_Map","label":"Pilots\u2019 field chart","x":0,"y":-8,"style":"leaf","rules":[{"line":"Three soundings make a safe entry. Read the brass rubbing in the western chapel, sight the two posts at Split Stone to the east, and climb the northern lookout. Then signal from the eastern mast.","when":[],"award":"","move":"","to":""}],"note":0},{"id":"A_Depth","label":"Tide chapel rubbing","x":-40,"y":-24,"style":"rubbing","rules":[{"line":"A gull\u2019s wing marks the full-flood line, above the drowned bell. Mirren\u2019s cutter draws three fathoms. Open her passage with the WING flag.","when":[{"signal":"charter","value":1}],"award":"sounding","move":"","to":""},{"line":"A tide scale beside a worn footprint. The shore pilot can tell you whose draft to look for.","when":[],"award":"","move":"","to":""}],"note":0},{"id":"A_Transit","label":"Split Stone transit","x":40,"y":-4,"style":"sight","rules":[{"line":"Look along the brass rail. The two ringed posts meet around the bell on the offshore rock. BELL is the second flag while the cutter crosses the bar.","when":[{"signal":"charter","value":1}],"award":"leading","move":"","to":""},{"line":"Two rings frame a distant mark. Find Mirren in the chart shelter to learn the pilot code.","when":[],"award":"","move":"","to":""}],"sight":"BellBearing","evidence":"leading","direction":"Look north along the brass rail. Center the gold bell beyond the two rings, then press E or trigger.","note":0},{"id":"A_Lookout","label":"North bluff glass","x":-28,"y":35,"style":"scope","rules":[{"line":"Through the blue glass, the Linnet flashes the keeper\u2019s star. STAR answers her and brings her into shelter. Raise the flags at the eastern mast.","when":[{"signal":"charter","value":1}],"award":"distress","move":"","to":""},{"line":"Someone left the scope trained on a cutter. The shore pilot knows her call sign.","when":[],"award":"","move":"","to":""}],"sight":"StarBearing","evidence":"distress","direction":"Face the cutter beyond the northern bluff. Center the star above her sail, then press E or trigger.","note":0},{"id":"A_Wing","label":"Swallowtail halyard","x":23,"y":29,"style":"halyard","rules":[{"line":"The Linnet has crossed the reef. Go to the stone landing.","when":[{"signal":"landed","value":1}],"award":"","move":"","to":""},{"line":"A shutter flashes from the cutter. She has acknowledged {signalBar} of three signals.","when":[{"signal":"sounding","value":1},{"signal":"leading","value":1},{"signal":"distress","value":1}],"award":"","move":"lampcode.wing","to":""},{"line":"The shore pilot requires all three observations before you give a vessel the way. Check the chart.","when":[],"award":"","move":"","to":""}],"note":0},{"id":"A_Bell","label":"Bell halyard","x":27,"y":29,"style":"halyard","rules":[{"line":"The Linnet has crossed the reef. Go to the stone landing.","when":[{"signal":"landed","value":1}],"award":"","move":"","to":""},{"line":"A shutter flashes from the cutter. She has acknowledged {signalBar} of three signals.","when":[{"signal":"sounding","value":1},{"signal":"leading","value":1},{"signal":"distress","value":1}],"award":"","move":"lampcode.bell","to":""},{"line":"The shore pilot requires all three observations before you give a vessel the way. Check the chart.","when":[],"award":"","move":"","to":""}],"note":0},{"id":"A_Star","label":"Star halyard","x":31,"y":29,"style":"halyard","rules":[{"line":"The Linnet has crossed the reef. Go to the stone landing.","when":[{"signal":"landed","value":1}],"award":"","move":"","to":""},{"line":"A shutter flashes from the cutter. She has acknowledged {signalBar} of three signals.","when":[{"signal":"sounding","value":1},{"signal":"leading","value":1},{"signal":"distress","value":1}],"award":"","move":"lampcode.star","to":""},{"line":"The shore pilot requires all three observations before you give a vessel the way. Check the chart.","when":[],"award":"","move":"","to":""}],"note":0},{"id":"A_Launch","label":"Harbour capstan","x":35,"y":27,"style":"winch","rules":[{"line":"The rescue line is fast. The pilot is waiting at the northern landing.","when":[{"signal":"landed","value":1}],"award":"","move":"","to":""},{"line":"The line pulls taut. The Linnet clears the last rock and ties up below the lantern. Seven people step ashore.","when":[{"signal":"signalBar","value":3}],"award":"landed","move":"","to":""},{"line":"The reef line cannot be hauled until the cutter acknowledges all three flags.","when":[],"award":"","move":"","to":""}],"note":0},{"id":"A_Book","label":"Flood book landing","x":8,"y":43,"style":"landing","rules":[{"line":"SKIPPER ELIN  /  Seven of us. Seven signatures. Take our book to the bell and tell them a promise needs a crew.","when":[{"signal":"landed","value":1}],"award":"","move":"","to":"@final"},{"line":"The berth is empty. Signal the cutter from the eastern mast.","when":[],"award":"","move":"","to":""}],"note":0},{"id":"A_Back","label":"Down to the resonator","x":-9,"y":-13,"style":"lift","rules":[{"line":"","when":[],"award":"","move":"","to":"EchoRotunda"}],"note":0}],"visuals":[{"node":"Reading0","signal":"sounding","kind":"show","amount":1,"match":1},{"node":"Reading1","signal":"leading","kind":"show","amount":1,"match":1},{"node":"Reading2","signal":"distress","kind":"show","amount":1,"match":1},{"node":"Hoist1","signal":"signalBar","kind":"show","amount":1,"match":1},{"node":"Hoist2","signal":"signalBar","kind":"show","amount":1,"match":2},{"node":"Hoist3","signal":"signalBar","kind":"show","amount":1,"match":3},{"node":"Linnet","signal":"landed","kind":"voyage","amount":9,"match":1},{"node":"CrewAshore","signal":"landed","kind":"show","amount":1,"match":1}],"halfSpan":60,"chapter":"The Pilots\u2019 Coast"}],"logTitle":"The Linnet\u2019s flood book","logEntry":"Six salt-blurred names and Elin\u2019s careful seventh. In the margin she wrote, \u201cA bell can call for hands. It cannot promise on their behalf.\u201d","logEndings":["Elin has signed for the night tide. Six lines stand open for volunteers.","Ina opens the pilots\u2019 book to the last page. \u201cDo you think Elin would teach me to steer?\u201d"]}
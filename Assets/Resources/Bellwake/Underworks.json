finished","value":1}],"award":"token","move":"","to":""},{"line":"OSSA  /  Give me the lockkeeper\u2019s knot, the archivist\u2019s pay leaf and the foreman\u2019s spare wage. Once the casting is finished I can press a permanent nameplate.","when":[],"award":"","move":"","to":""}],"note":2}],"visuals":[{"node":"LiquidBronze","signal":"molten","kind":"show","amount":1,"match":1},{"node":"BrightYoke","signal":"finished","kind":"show","amount":1,"match":1}]},{"key":"LanternCourt","title":"Court of Borrowed Light","intro":"A shutter sends one shaft of light down either aisle. Both receiving cups must hold a reflection to wake the observatory.","theme":"Lampworks","stations":[{"id":"A_Fork","label":"Swing the shutter","x":0,"y":-5,"style":"wheel","rules":[{"line":"The west mirror reads {left}; east reads {right}. Follow the glass line to the two receiving cups.","when":[],"award":"","move":"prism.fork","to":""}],"note":0},{"id":"A_Left","label":"Turn the moon mirror","x":-8,"y":2,"style":"wheel","rules":[{"line":"The west mirror reads {left}; east reads {right}. Follow the glass line to the two receiving cups.","when":[],"award":"","move":"prism.left","to":""}],"note":0},{"id":"A_Right","label":"Turn the sun mirror","x":8,"y":2,"style":"wheel","rules":[{"line":"The west mirror reads {left}; east reads {right}. Follow the glass line to the two receiving cups.","when":[],"award":"","move":"prism.right","to":""}],"note":0},{"id":"A_Catch","label":"Capture the reflection","x":0,"y":8,"style":"lever","rules":[{"line":"Moon stored {moon}/1. Sun stored {sun}/1.","when":[],"award":"","move":"prism.catch","to":""}],"note":0},{"id":"A_Iris","label":"Release the iris","x":0,"y":11,"style":"lever","rules":[{"line":"Both cups flare. The roof iris slides open.","when":[{"signal":"moon","value":1},{"signal":"sun","value":1}],"award":"opticKey","move":"","to":""},{"line":"The moon and sun cups must each store a reflection.","when":[],"award":"","move":"","to":""}],"note":0},{"id":"A_Etching","label":"A lampmaker\u2019s etching","x":-12,"y":9,"style":"leaf","rules":[{"line":"The moon silver was cut on its second face. The sun brass took its third. Aim the shutter down each aisle and capture its light before you switch.","when":[],"award":"","move":"","to":""}],"note":0},{"id":"A_Loft","label":"Orrery lift","x":8,"y":12,"style":"lift","rules":[{"line":"","when":[{"signal":"opticKey","value":1}],"award":"","move":"","to":"OrreryLoft"},{"line":"The lift is still locked.","when":[],"award":"","move":"","to":""}],"note":0},{"id":"A_Home","label":"Cistern lift","x":-12,"y":-10,"style":"lift","rules":[{"line":"","when":[],"award":"","move":"","to":"SumpHall"}],"note":0}],"visuals":[{"node":"WestRay","signal":"westRay","kind":"show","amount":1,"match":1},{"node":"EastRay","signal":"eastRay","kind":"show","amount":1,"match":1},{"node":"MoonRay","signal":"moonRay","kind":"show","amount":1,"match":1},{"node":"SunRay","signal":"sunRay","kind":"show","amount":1,"match":1},{"node":"MoonCup","signal":"moon","kind":"show","amount":1,"match":1},{"node":"SunCup","signal":"sun","kind":"show","amount":1,"match":1},{"node":"Shutter","signal":"fork","kind":"turn","amount":90,"match":1},{"node":"MoonMirror","signal":"left","kind":"turn","amount":90,"match":1},{"node":"SunMirror","signal":"right","kind":"turn","amount":90,"match":1}]},{"key":"OrreryLoft","title":"The Unwound Orrery","intro":"The last sky of the flood has slipped out of the calendar. Sight the three fixed bearings around the gallery, then wind the brass rings.","theme":"Lampworks","stations":[{"id":"A_Oak","label":"Wind the oak ring","x":-7,"y":-3,"style":"wheel","rules":[{"line":"Oak {oak}, wren {wren}, tide {tide}. Each dial counts zero through three.","when":[],"award":"","move":"orbits.outer","to":""}],"note":0},{"id":"A_Wren","label":"Wind the wren ring","x":0,"y":-5,"style":"wheel","rules":[{"line":"Oak {oak}, wren {wren}, tide {tide}. Each dial counts zero through three.","when":[],"award":"","move"